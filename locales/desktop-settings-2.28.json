[
  {
    "id": "v228.ui.1",
    "source": "The agent auto-executes commands matched by an allow list entry. For Unix shells, an allow list entry matches a command if its space-separated tokens form a prefix of the command's tokens. For PowerShell, the entry tokens may match any contiguous subsequence of the command tokens.",
    "target": "智能体会自动执行与允许列表条目匹配的命令。对于 Unix shell，如果条目中以空格分隔的 token 构成命令 token 的前缀，即视为匹配。对于 PowerShell，条目 token 可匹配命令 token 中的任意连续子序列。",
    "context": "Antigravity 2.28.2 设置、终端执行策略与远程数据管理固定文案",
    "scope": "settings",
    "reviewed": true,
    "origins": [
      {
        "start": 4053203,
        "end": 4053486,
        "kind": "property:description"
      }
    ]
  },
  {
    "id": "v228.ui.2",
    "source": "The agent asks for permission before executing commands matched by a deny list entry. The deny list follows the same matching rules as the allow list and takes precedence over the allow list.",
    "target": "执行与拒绝列表条目匹配的命令前，智能体会请求授权。拒绝列表遵循与允许列表相同的匹配规则，并且优先于允许列表。",
    "context": "Antigravity 2.28.2 设置、终端执行策略与远程数据管理固定文案",
    "scope": "settings",
    "reviewed": true,
    "origins": [
      {
        "start": 4053643,
        "end": 4053836,
        "kind": "property:description"
      }
    ]
  },
  {
    "id": "v228.ui.3",
    "source": "Controls whether terminal commands require your approval before running.\n\nNote: A change to this setting will only apply to new messages sent to the agent. In-progress responses will use the previous setting value.",
    "target": "控制终端命令运行前是否需要你的批准。\n\n注意：更改仅对发送给智能体的新消息生效，正在进行的回复仍使用之前的设置。",
    "context": "Antigravity 2.28.2 设置、终端执行策略与远程数据管理固定文案",
    "scope": "settings",
    "reviewed": true,
